{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(fd:*)",
      "Bash(rg:*)",
      "WebFetch",
      "WebSearch",

      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",

      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh label list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",

      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git worktree list)",

      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle exec standardrb:*)",
      "Bash(bundle exec rails test:*)",
      "Bash(bundle exec rails routes:*)",
      "Bash(bundle exec rails db:migrate:status:*)",
      "Bash(bundle exec rake -T:*)",
      "Bash(bundle info:*)",
      "Bash(bundle list:*)",
      "Bash(bundle show:*)",
      "Bash(bundle outdated:*)",
      "Bash(bin/rails routes:*)",
      "Bash(bin/rails test:*)",
      "Bash(bin/rails db:migrate:status:*)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rake -T:*)",

      "Bash(ruby -c:*)",

      "mcp__plugin_context7_context7",

      "mcp__appsignal__get_applications",
      "mcp__appsignal__get_anomaly_incidents",
      "mcp__appsignal__get_exception_incidents",
      "mcp__appsignal__get_incident",
      "mcp__appsignal__discover_metrics",
      "mcp__appsignal__get_metrics_list",

      "mcp__metabase__get_table_field_values",
      "mcp__metabase__get_table",

      "mcp__grafana__list_datasources",
      "mcp__grafana__grafana_api_request"
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/pgolm/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "fallbackModel": ["sonnet", "haiku"],
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ruby-lsp@claude-code-lsps": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "language": "German",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell"
}
